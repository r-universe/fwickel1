[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "eba"]
	path = eba
	url = https://github.com/cran/eba
[submodule "mpt"]
	path = mpt
	url = https://github.com/cran/mpt
[submodule "pks"]
	path = pks
	url = https://codeberg.org/fwickel/pks
